# --- providers (default: all Sarvam) ---
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
# sarvam | anthropic
LLM_PROVIDER=sarvam
# blank = provider default (sarvam-105b-conversations / claude-opus-5)
LLM_MODEL=

# --- keys ---
SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# --- Sarvam tuning (optional) ---
SARVAM_STT_MODEL=saaras:v3
# romanised Hinglish, matches topic_router keywords
SARVAM_STT_MODE=translit
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_CODEC=mp3
# json_schema | json_object | none
SARVAM_JSON_MODE=json_schema
# none | low | medium | high
SARVAM_REASONING_EFFORT=none

# --- Claude tuning (optional) ---
ANTHROPIC_EFFORT=low

# --- app ---
BRAND_NAME=Suraksha Advisory
ACCESS_CODE=change-me
LOG_LEVEL=INFO

# --- Google Sheets (M5); leave blank to log to data/leads.csv ---
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
