# --- providers (default: all Sarvam) ---
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
LLM_PROVIDER=sarvam            # sarvam | anthropic
LLM_MODEL=                     # blank = provider default (sarvam-105b-conversations / claude-opus-5)

# --- keys ---
SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# --- Sarvam tuning (optional) ---
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translit       # romanised Hinglish, matches topic_router keywords
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_CODEC=mp3
SARVAM_JSON_MODE=json_schema   # json_schema | json_object | none
SARVAM_REASONING_EFFORT=none   # none | low | medium | high

# --- Claude tuning (optional) ---
ANTHROPIC_EFFORT=low

# --- app ---
BRAND_NAME=Suraksha Advisory
ACCESS_CODE=change-me
LOG_LEVEL=INFO

# --- Google Sheets (M5); leave blank to log to data/leads.csv ---
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
